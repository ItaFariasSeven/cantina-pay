generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  nome      String
  senha     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cliente {
  id         String      @id @default(uuid())
  nomeAluno  String
  nomePai    String
  saldo      Decimal     @default(0) @db.Decimal(10, 2)
  compras    Compra[]
  pagamentos Pagamento[] // Relação com Pagamento
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Categoria {
  id       String    @id @default(uuid())
  nome     String
  icone    String?   // A coluna de ícone que adicionamos!
  produtos Produto[]
}

model Produto {
  id          String       @id @default(uuid())
  nome        String
  preco       Decimal      @db.Decimal(10, 2)
  imagem      String?
  categoriaId String?
  categoria   Categoria?    @relation(fields: [categoriaId], references: [id])
  itens       ItemCompra[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Compra {
  id          Int         @id @default(autoincrement())
  clienteId   String?     // CORREÇÃO: Mudou de Int? para String? (Para bater com Cliente.id)
  cliente     Cliente?    @relation(fields: [clienteId], references: [id])
  itens       ItemCompra[]
  valorManual Decimal     @default(0) @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  status      String      @default("pendente") // pendente | paga | cancelada
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  pagamentos  Pagamento[]
}

model ItemCompra {
  id            String   @id @default(uuid())
  compraId      Int      // CORREÇÃO: Mudou de String para Int (Para bater com Compra.id)
  compra        Compra   @relation(fields: [compraId], references: [id], onDelete: Cascade)
  produtoId     String
  produto       Produto  @relation(fields: [produtoId], references: [id])
  quantidade    Int
  precoUnitario Decimal  @db.Decimal(10, 2)
}

model Pagamento {
  id        Int      @id @default(autoincrement())
  compraId  Int
  compra    Compra   @relation(fields: [compraId], references: [id])
  clienteId String?  // CORREÇÃO: Adicionado para o cliente poder acessar seus pagamentos
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  valor     Decimal  @db.Decimal(10, 2)
  data      DateTime @default(now())
  createdAt DateTime @default(now())
}
